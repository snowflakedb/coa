# Shared builder-framework knobs (the GCL mirror of the runtime
# yeti.generation.builder.builder_settings.BuilderSettings base class).
#
# Included by every generator built on the builder framework (query_generator.gcl,
# equivalence_generator_v3.gcl) and instantiated as a `builder_settings` sub-tuple,
# with each generator overriding the values it cares about, e.g.
#   builder_settings = BuilderSettings { max_depth = 10; };

# Builder-stack recursion limit.
max_depth: int = 8;
# Surviving-tree node budget; triggers leaf-only mode when exhausted.  0 = unlimited.
max_nodes: int = 0;
# Total nodes-built budget (incl. subtrees discarded by a failed parent); a
# work/thrash ceiling that also triggers leaf-only mode.  0 = unlimited.
max_attempts: int = 0;
