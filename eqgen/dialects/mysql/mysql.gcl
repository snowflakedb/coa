# MySQL equivalence configuration. GCL lists replace rather than merge.
#
# Portable builders not proven on MySQL stay at weight 0. As of this pass, every portable builder
# has been swept (and several also campaign-tested under --forks 2+) against a live MySQL 9.7
# server at least once; the ones still at 0 (CreateTemporaryViewBuilder, CreateTemporaryTableBuilder,
# MaterializedCteQueryBuilder, NotMaterializedCteQueryBuilder, SemiJoinFlagRoundTripBuilder) are
# confirmed dialect-incompatible, not merely untested — see the comment next to each.

eqg3: private = include '../../config/gcl/equivalence_generator_v3.gcl';
Weighted: private = include '../../config/gcl/weighted.gcl';

equivalence_generator_v3 = eqg3 {
    builder_weights: [Weighted] = [
        Weighted { v = 'CreateViewBuilder'; weight = 10; },
        Weighted { v = 'CreateTableBuilder'; weight = 10; },
        # MySQL has no CREATE TEMPORARY VIEW (temp objects are tables/tables-only) — confirmed via
        # sweep: ProgrammingError 1064 on every seed, not a rare decline. Stays 0.
        Weighted { v = 'CreateTemporaryViewBuilder'; weight = 0; },
        # Sweep-in-isolation looked fine (13/15 ok), but composed into the full builder graph a
        # MySQL TEMPORARY table gets asked for twice by a self-join/self-reference builder
        # (FlagTableJoinQueryBuilder et al.) in one statement, which MySQL flatly rejects: "Can't
        # reopen table" (errno 1137) — unlike a permanent table/view, a TEMPORARY table cannot
        # appear twice in the same statement's FROM list. Confirmed via
        # test_a_round_runs_end_to_end_on_mysql / test_generated_objects_hold_the_same_rows_on_mysql
        # going from green to a deterministic seed failure the moment this builder's weight left 0.
        # Not portable to MySQL's composition model; stays 0.
        Weighted { v = 'CreateTemporaryTableBuilder'; weight = 0; },
        # MySQL 9.7 accepts CREATE MATERIALIZED VIEW syntactically (SHOW CREATE VIEW echoes
        # `MATERIALIZED /*(BY ENGINE=UNKNOWN)*/`) but information_schema reports table_type=VIEW
        # and it live-updates on base-table DML with no REFRESH — i.e. it is not actually
        # materialized. Undocumented in the 9.7 release notes/refman. Harmless for eqgen's
        # read-only oracle (no DML is ever applied through this builder), so proven safe to fuzz.
        Weighted { v = 'CreateMaterializedViewBuilder'; weight = 5; },
        Weighted { v = 'DeleteReinsertTableBuilder'; weight = 4; },
        Weighted { v = 'NoopUpdateTableBuilder'; weight = 4; },
        Weighted { v = 'SelectStarQueryBuilder'; weight = 5; },
        Weighted { v = 'ExplicitProjectionQueryBuilder'; weight = 6; },
        Weighted { v = 'CteQueryBuilder'; weight = 5; },
        # MySQL's WITH clause has no MATERIALIZED/NOT MATERIALIZED optimizer hint (that's Postgres/
        # DuckDB syntax) — confirmed via sweep: ProgrammingError 1064 on every seed. Stay 0.
        Weighted { v = 'MaterializedCteQueryBuilder'; weight = 0; },
        Weighted { v = 'NotMaterializedCteQueryBuilder'; weight = 0; },
        Weighted { v = 'LateralReprojectQueryBuilder'; weight = 5; },
        Weighted { v = 'AddDropColumnQueryBuilder'; weight = 4; },
        Weighted { v = 'QualifyQueryBuilder'; weight = 5; },
        Weighted { v = 'OrderedScanQueryBuilder'; weight = 5; },
        Weighted { v = 'PartitionUnionQueryBuilder'; weight = 6; },
        Weighted { v = 'TlpPartitionUnionQueryBuilder'; weight = 6; },
        Weighted { v = 'RankModUnionQueryBuilder'; weight = 5; },
        Weighted { v = 'UnionEmptyRoundTripBuilder'; weight = 5; },
        Weighted { v = 'ExceptEmptyRoundTripBuilder'; weight = 5; },
        Weighted { v = 'IntersectSelfRoundTripBuilder'; weight = 5; },
        # Codec round trips: 0, and not for want of the functions -- MySQL has HEX/UNHEX,
        # TO_BASE64/FROM_BASE64 and JSON_OBJECT. Two things a spelling cannot fix. The declared type
        # of an expression-materialized text column never matches the base column's (VARCHAR 253
        # becomes TEXT 252; CHAR 254 and TEXT 252 have no matching form at all -- checked against a
        # live server through both SELECT and CREATE VIEW), so the equivalence pre-gate rejects the
        # object on types while the rows agree. And CAST(x AS CHAR(n)) resets the collation to the
        # connection default, which flips string comparisons -- see the COLLATE guard in
        # MySqlJsonPackRoundTripObject, which is why that bespoke builder stays.
        Weighted { v = 'HexCodecRoundTripBuilder'; weight = 0; },
        Weighted { v = 'Base64CodecRoundTripBuilder'; weight = 0; },
        Weighted { v = 'JsonPackCodecRoundTripBuilder'; weight = 0; },
        Weighted { v = 'MixedCodecRoundTripBuilder'; weight = 0; },
        Weighted { v = 'DistinctAsGroupByQueryBuilder'; weight = 5; },
        Weighted { v = 'DistinctUnionDuplicateQueryBuilder'; weight = 5; },
        Weighted { v = 'CrossJoinFilterAsInnerBuilder'; weight = 5; },
        Weighted { v = 'EetCaseColumnQueryBuilder'; weight = 6; },
        Weighted { v = 'EetDeterminedFilterQueryBuilder'; weight = 6; },
        Weighted { v = 'WindowRewriteQueryBuilder'; weight = 6; },
        Weighted { v = 'FlagTableJoinQueryBuilder'; weight = 5; },
        Weighted { v = 'SequenceOuterJoinQueryBuilder'; weight = 5; },
        Weighted { v = 'LeftJoinEmptyQueryBuilder'; weight = 5; },
        # SEMI is DuckDB-native join syntax (hardcoded literal "SEMI" in
        # SemiJoinFlagRoundTripBuilder._build — see joins.py's own docstring: "weight it 0 on
        # PostgreSQL"). MySQL has no SEMI JOIN either — confirmed live: "You have an error in your
        # SQL syntax ... near 'SEMI JOIN t__base_table_14 r ON ...'". My mistake enabling this
        # from the earlier low-seed sweep, which didn't happen to hit the emission path. Stays 0.
        Weighted { v = 'SemiJoinFlagRoundTripBuilder'; weight = 0; },
        Weighted { v = 'KeyDistinctReduceBuilder'; weight = 5; },
        Weighted { v = 'KeyGroupAggregateReduceBuilder'; weight = 5; },
        Weighted { v = 'KeyWindowAggregateReduceBuilder'; weight = 5; },
        Weighted { v = 'KeyQualifyDedupReduceBuilder'; weight = 5; },
        Weighted { v = 'KeyExplodeExpansionBuilder'; weight = 5; },
        Weighted { v = 'KeyInsertExtrasExpansionBuilder'; weight = 5; },
        Weighted { v = 'TagPruneDeleteReduceBuilder'; weight = 5; },
        Weighted { v = 'TagPruneFilterReduceBuilder'; weight = 5; },
        Weighted { v = 'TagExplodeExpansionBuilder'; weight = 5; },
        Weighted { v = 'TagInsertExtrasExpansionBuilder'; weight = 5; },
        Weighted { v = 'ProjectionQueryBuilder'; weight = 6; },
        Weighted { v = 'BaseTableSourceBuilder'; weight = 10; },

        Weighted { v = 'MySqlPlainIndexBuilder'; weight = 6; },
        Weighted { v = 'MySqlUniqueIndexBuilder'; weight = 6; },
        Weighted { v = 'MySqlInvisibleIndexBuilder'; weight = 4; },
        Weighted { v = 'MySqlPrefixIndexBuilder'; weight = 4; },
        Weighted { v = 'MySqlInnodbTableBuilder'; weight = 4; },
        Weighted { v = 'MySqlJsonPackRoundTripBuilder'; weight = 6; },
    ];

    root_builder_weights: [Weighted] = [
        Weighted { v = 'CreateViewBuilder'; weight = 10; },
        Weighted { v = 'CreateTableBuilder'; weight = 10; },
        Weighted { v = 'CreateTemporaryViewBuilder'; weight = 0; },
        # Also unsafe at root: a MySQL TEMPORARY table can't survive being referenced twice by the
        # *workload* query either (e.g. a self-join/correlated-subquery pattern referencing the
        # exposed root table twice) — "Can't reopen table" (1137) again. See the builder_weights
        # comment above; the restriction is not specific to nested composition. Stays 0.
        Weighted { v = 'CreateTemporaryTableBuilder'; weight = 0; },
        Weighted { v = 'CreateMaterializedViewBuilder'; weight = 4; },
        Weighted { v = 'DeleteReinsertTableBuilder'; weight = 4; },
        Weighted { v = 'NoopUpdateTableBuilder'; weight = 4; },
        Weighted { v = 'KeyDistinctReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyGroupAggregateReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyWindowAggregateReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyQualifyDedupReduceBuilder'; weight = 8; },
        Weighted { v = 'TagPruneDeleteReduceBuilder'; weight = 3; },
        Weighted { v = 'TagPruneFilterReduceBuilder'; weight = 3; },
        Weighted { v = 'MySqlPlainIndexBuilder'; weight = 6; },
        Weighted { v = 'MySqlUniqueIndexBuilder'; weight = 6; },
        Weighted { v = 'MySqlInvisibleIndexBuilder'; weight = 4; },
        Weighted { v = 'MySqlPrefixIndexBuilder'; weight = 4; },
        Weighted { v = 'MySqlInnodbTableBuilder'; weight = 4; },
        Weighted { v = 'MySqlJsonPackRoundTripBuilder'; weight = 6; },
    ];
};
