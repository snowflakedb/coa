# DuckDB's equivalence configuration, declared rather than assembled in Python.
#
# GCL lists replace rather than merge, so the whole list is restated.

eqg3: private = include '../../config/gcl/equivalence_generator_v3.gcl';
Weighted: private = include '../../config/gcl/weighted.gcl';
BuilderSettings: private = include '../../config/gcl/builder_settings.gcl';

equivalence_generator_v3 = eqg3 {
    builder_settings = BuilderSettings { max_depth = 22; max_nodes = 0; max_attempts = 0; };
    builder_weights: [Weighted] = [
        Weighted { v = 'CreateViewBuilder'; weight = 10; },
        Weighted { v = 'CreateTableBuilder'; weight = 10; },
        Weighted { v = 'CreateTemporaryViewBuilder'; weight = 4; },
        Weighted { v = 'CreateTemporaryTableBuilder'; weight = 4; },
        # DuckDB has no CREATE MATERIALIZED VIEW; use MaterializedCteQueryBuilder instead.
        Weighted { v = 'CreateMaterializedViewBuilder'; weight = 0; },
        Weighted { v = 'DeleteReinsertTableBuilder'; weight = 4; },
        Weighted { v = 'NoopUpdateTableBuilder'; weight = 4; },
        Weighted { v = 'SelectStarQueryBuilder'; weight = 10; },
        Weighted { v = 'ExplicitProjectionQueryBuilder'; weight = 6; },
        Weighted { v = 'CteQueryBuilder'; weight = 6; },
        Weighted { v = 'MaterializedCteQueryBuilder'; weight = 12; },
        # DuckDB honors AS NOT MATERIALIZED; was left at 0 with no incompatibility note.
        Weighted { v = 'NotMaterializedCteQueryBuilder'; weight = 10; },
        Weighted { v = 'LateralReprojectQueryBuilder'; weight = 6; },
        Weighted { v = 'AddDropColumnQueryBuilder'; weight = 4; },
        Weighted { v = 'QualifyQueryBuilder'; weight = 14; },
        Weighted { v = 'OrderedScanQueryBuilder'; weight = 3; },
        Weighted { v = 'PartitionUnionQueryBuilder'; weight = 12; },
        Weighted { v = 'TlpPartitionUnionQueryBuilder'; weight = 12; },
        Weighted { v = 'RankModUnionQueryBuilder'; weight = 12; },
        Weighted { v = 'UnionEmptyRoundTripBuilder'; weight = 10; },
        Weighted { v = 'ExceptEmptyRoundTripBuilder'; weight = 12; },
        Weighted { v = 'IntersectSelfRoundTripBuilder'; weight = 12; },
        Weighted { v = 'HexCodecRoundTripBuilder'; weight = 8; },
        Weighted { v = 'Base64CodecRoundTripBuilder'; weight = 8; },
        Weighted { v = 'JsonPackCodecRoundTripBuilder'; weight = 8; },
        Weighted { v = 'MixedCodecRoundTripBuilder'; weight = 6; },
        Weighted { v = 'DistinctAsGroupByQueryBuilder'; weight = 5; },
        Weighted { v = 'DistinctUnionDuplicateQueryBuilder'; weight = 5; },
        Weighted { v = 'CrossJoinFilterAsInnerBuilder'; weight = 5; },
        Weighted { v = 'EetCaseColumnQueryBuilder'; weight = 6; },
        Weighted { v = 'EetDeterminedFilterQueryBuilder'; weight = 6; },
        Weighted { v = 'WindowRewriteQueryBuilder'; weight = 14; },
        Weighted { v = 'FlagTableJoinQueryBuilder'; weight = 5; },
        Weighted { v = 'SequenceOuterJoinQueryBuilder'; weight = 5; },
        Weighted { v = 'LeftJoinEmptyQueryBuilder'; weight = 5; },
        Weighted { v = 'SemiJoinFlagRoundTripBuilder'; weight = 14; },
        Weighted { v = 'KeyDistinctReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyGroupAggregateReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyWindowAggregateReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyQualifyDedupReduceBuilder'; weight = 10; },
        Weighted { v = 'KeyExplodeExpansionBuilder'; weight = 3; },
        Weighted { v = 'KeyInsertExtrasExpansionBuilder'; weight = 2; },
        Weighted { v = 'TagPruneDeleteReduceBuilder'; weight = 3; },
        Weighted { v = 'TagPruneFilterReduceBuilder'; weight = 3; },
        Weighted { v = 'TagExplodeExpansionBuilder'; weight = 3; },
        Weighted { v = 'TagInsertExtrasExpansionBuilder'; weight = 2; },
        Weighted { v = 'ProjectionQueryBuilder'; weight = 6; },
        Weighted { v = 'BaseTableSourceBuilder'; weight = 10; },

        # High-payoff Mats / joins / codecs (biased up).
        Weighted { v = 'DuckDBAntiJoinEmptyRoundTripBuilder'; weight = 18; },
        Weighted { v = 'DuckDBAsofLeftEmptyRoundTripBuilder'; weight = 14; },
        Weighted { v = 'DuckDBExceptAllEmptyTableRoundTripBuilder'; weight = 16; },
        Weighted { v = 'DuckDBCreateMacroBuilder'; weight = 8; },
        Weighted { v = 'DuckDBCreateIndexBuilder'; weight = 12; },
        Weighted { v = 'DuckDBUniqueIndexMatBuilder'; weight = 14; },
        Weighted { v = 'DuckDBAttachedDatabaseBuilder'; weight = 8; },
        Weighted { v = 'DuckDBEnumTypeRoundTripBuilder'; weight = 8; },
        Weighted { v = 'DuckDBSchemaQualifiedTableBuilder'; weight = 3; },
        Weighted { v = 'DuckDBAddDropColumnTableBuilder'; weight = 8; },
        Weighted { v = 'DuckDBCheckpointTableBuilder'; weight = 8; },
        Weighted { v = 'DuckDBPositionalJoinRoundTripBuilder'; weight = 8; },
        Weighted { v = 'DuckDBRecursiveCteIdentityBuilder'; weight = 12; },
        Weighted { v = 'DuckDBRowNumberBoundQualifyBuilder'; weight = 10; },
        Weighted { v = 'DuckDBStarReplaceIdentityBuilder'; weight = 4; },
        Weighted { v = 'DuckDBPivotStructRoundTripBuilder'; weight = 14; },
        Weighted { v = 'DuckDBListPackRoundTripBuilder'; weight = 14; },
        Weighted { v = 'DuckDBListTransformRoundTripBuilder'; weight = 12; },
        Weighted { v = 'DuckDBListFilterRoundTripBuilder'; weight = 12; },
        Weighted { v = 'DuckDBMapPackRoundTripBuilder'; weight = 12; },
        Weighted { v = 'DuckDBStructPackRoundTripBuilder'; weight = 12; },
    ];

    root_builder_weights: [Weighted] = [
        Weighted { v = 'CreateViewBuilder'; weight = 10; },
        Weighted { v = 'CreateTableBuilder'; weight = 10; },
        Weighted { v = 'CreateTemporaryViewBuilder'; weight = 4; },
        Weighted { v = 'CreateTemporaryTableBuilder'; weight = 4; },
        Weighted { v = 'CreateMaterializedViewBuilder'; weight = 0; },
        Weighted { v = 'DeleteReinsertTableBuilder'; weight = 4; },
        Weighted { v = 'NoopUpdateTableBuilder'; weight = 4; },
        Weighted { v = 'KeyDistinctReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyGroupAggregateReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyWindowAggregateReduceBuilder'; weight = 3; },
        Weighted { v = 'KeyQualifyDedupReduceBuilder'; weight = 10; },
        Weighted { v = 'TagPruneDeleteReduceBuilder'; weight = 3; },
        Weighted { v = 'TagPruneFilterReduceBuilder'; weight = 3; },
        Weighted { v = 'DuckDBCreateMacroBuilder'; weight = 8; },
        Weighted { v = 'DuckDBCreateIndexBuilder'; weight = 12; },
        Weighted { v = 'DuckDBUniqueIndexMatBuilder'; weight = 14; },
        Weighted { v = 'DuckDBAttachedDatabaseBuilder'; weight = 8; },
        Weighted { v = 'DuckDBEnumTypeRoundTripBuilder'; weight = 8; },
        Weighted { v = 'DuckDBSchemaQualifiedTableBuilder'; weight = 3; },
        Weighted { v = 'DuckDBAddDropColumnTableBuilder'; weight = 6; },
        Weighted { v = 'DuckDBCheckpointTableBuilder'; weight = 6; },
        Weighted { v = 'DuckDBExceptAllEmptyTableRoundTripBuilder'; weight = 12; },
    ];
};
